  "keyFeatures": [
    "Linear and Iterative OpMode programming models for TeleOp and Autonomous periods",
    "Hardware abstraction via HardwareMap for motors, servos, and sensors",
    "Universal IMU interface supporting both BNO055 and BHI260AP inertial measurement units",
    "TensorFlow Lite object detection and Vuforia field navigation for computer vision",
    "OnBot Java and Blocks programming tools for in-browser robot coding without Android Studio",
    "External hardware class pattern for sharing hardware configuration across multiple OpModes",
    "Bulk-read support for REV Expansion/Control Hub to optimize I2C cycle times",
    "Gamepad rumble, touchpad, and LED control APIs for driver feedback",
    "Annotation-based OpMode registration with @TeleOp, @Autonomous, and @Disabled",
    "TeamCode module as a clean separation point for team-specific robot code"
  ],
  "publicApiSurface": [
